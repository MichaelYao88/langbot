      "end_time": 44.199999999999996,
      "viet_words": []
    },
    {
      "speaker": "Mira",
      "text": "I play chess,",
      "start_time": 44.4,
      "end_time": 45.6,
      "viet_words": []
    },
    {
      "speaker": "Mira",
      "text": "I'm not a dreamer.",
      "start_time": 45.8,
      "end_time": 47.4,
      "viet_words": []
    },
    {
      "speaker": "Mira",
      "text": "Thời tiết is thời tiết,",
      "start_time": 47.599999999999994,
      "end_time": 49.599999999999994,
      "viet_words": []
    },
    {
      "speaker": "Mira",
      "text": "reality is reality.",
